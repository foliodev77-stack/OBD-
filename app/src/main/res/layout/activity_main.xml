<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="OBD Garage Pro" android:textStyle="bold" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Ready" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/deviceSpinner" android:layout_width="match_parent" android:layout_height="56dp"/>
<Button android:id="@+id/connectBtn" android:text="CONNECT OBD" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/scanBtn" android:text="FULL VEHICLE SCAN" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/liveBtn" android:text="LIVE DATA" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/clearBtn" android:text="CLEAR DTC CODES" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/results" android:text="Connect the adapter, then run Full Vehicle Scan." android:textIsSelectable="true" android:textSize="16sp" android:paddingTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>